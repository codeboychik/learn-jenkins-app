pipeline {
    agent {
        docker {
            image 'node:22-alpine'
            reuseNode true
        }
    }
    stages {
        stage('Install Dependencies') {
            steps {
                sh '''
                    npm -v
                    npm ci                       
                   '''
            }
        }
        stage('Build and Test') {
            parallel {
                stage('Test') {
                    steps {
                        sh 'npm test'
                        sh '''
                           if [ ! -a ./build/index.html ]; then
                                exit 1;
                           fi
                            '''
                    }
                }
                stage('Build') {
                    steps {
                        sh 'npm run build'
                    }
                }
            }
        }
    }
}