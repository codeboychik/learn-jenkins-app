pipeline {
    agent {
        docker {
            image 'node:22-alpine'
            reuseNode true
            args '-u 0'
        }
    }
    stages {
        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }
        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }
        stage('Test') {
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.50.0-noble'
                }
            }
            steps {
                sh '''
                   npm test
                   test -f ./build/index.html
                   npx concurrently \\
                       "npx serve -s build" \\
                       "wait-on http://localhost:3000 && npx playwright test"
                    '''
            }
        }
    }
    post {
        always {
            junit 'test-results/junit.xml'
        }
    }
}