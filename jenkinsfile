pipeline {
    agent {
        docker {
            image 'oven/bun:latest'
            reuseNode true
        }
    }
    stages {
        stage('Install Dependencies') {
            steps {
                sh '''
                    env
                    bun -v
                    bun install
                    bunx playwright install
                   '''
            }
        }
        stage('Build and Test') {
            steps {
                sh ''' 
                    bun run testp
                    bun run jest
                    bun run build
                   '''
            }
        }
    }
}