pipeline {
    agent {
        docker {
            image 'oven/bun:latest'
            reuseNode true
        }
    }
    stages {
        stage('Install Dependencies') {
            steps {
                sh '''
                    bun -v   
                    bun install             
                   '''
            }
        }
        stage('Build and Test') {
            steps {
                sh '''
                    bun run build
                    bunx serve -s build &  
                    bun run testp
                    bun run test
                   '''
            }
        }
    }
}