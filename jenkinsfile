pipeline {
    agent {
        docker {
            image 'node:22'
            args '-u 0'
            reuseNode true
        }
    }
    stages {
        stage('Install Dependencies') {
            steps {
                sh '''
                    npm install -g bun
                    bun pm cache rm -f
                    bun install
                    bun -v
                    bunx
                    bunx playwright install
                   '''
            }
        }
        stage('Build and Test') {
            steps {
                sh ''' 
                    bun run testp
                    bun run jest
                    bun run build
                   '''
            }
        }
    }
}