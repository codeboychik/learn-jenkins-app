pipeline {
    agent any

    environment {
        NETLIFY_SITE_ID = '36c13370-5018-4c3f-a1f4-a67c86060fbb'
        NETLIFY_AUTH_TOKEN = credentials('NETLIFY_ACCESS_TOKEN')
    }

    stages {
        stage('Install & Build') {
            agent {
                docker {
                    image 'node:22-alpine'
                    reuseNode true
                }
            }
            stages {
                stage('Install Dependencies') {
                    steps {
                        sh 'npm ci'
                    }
                }
                stage('Build') {
                    steps {
                        sh 'npm run build'
                    }
                }
            }
        }
        stage('Test') {
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.54.2-noble'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    npx serve -s build &
                    npx playwright test --reporter=html
                    npm test
                    '''
            }
        }
        stage('Deploy') {
            agent {
                docker {
                    image 'node:22-alpine'
                    reuseNode true
                }
            }
            steps {
               sh '''
                    echo "deploying siteID $NETLIFY_SITE_ID"
                    ls -la
                    npx netlify deploy --dir=build --prod
                  '''

            }
        }
    }
    post {
        always {
            junit 'test-results/junit.xml'
            publishHTML(
                [
                    allowMissing: false,
                    alwaysLinkToLastBuild: false,
                    icon: '',
                    keepAll: false,
                    reportDir: 'playwright-report',
                    reportFiles: 'index.html',
                    reportName: 'PW Report',
                    reportTitles: '',
                    useWrapperFileDirectly: true
                ]
            )
        }
    }
}