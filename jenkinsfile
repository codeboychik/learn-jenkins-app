pipeline {
    agent any
    stages {
        stage('Install Dependencies') {
            agent {
                docker {
                    image 'node:22-alpine'
                    reuseNode true
                }
            }
            steps {
                sh 'npm ci'
            }
        }
        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }
        stage('Test') {
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.50.0-noble'
                    reuseNode true
                }
            }
            steps {
                sh 'ls -la'
                sh 'npm test'
                sh 'test -f ./build/index.html'
                sh 'npx serve -s build &'
                sh 'SERVER_PID=$!'
                sh 'npx playwright test'
                sh 'kill $SERVER_PID'
            }
        }
    }
    post {
        always {
            junit 'test-results/junit.xml'
            cleanWs()
        }
    }
}