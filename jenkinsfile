pipeline {
    agent {
        docker {
            image 'node:22'
            reuseNode true
            args '-u 0'
        }
    }
    stages {
        stage('Install Dependencies') {
            steps {
                sh '''
                    npm ci
                    npx playwright install --with-deps
                   '''
            }
        }
        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }
        stage('Test') {
            steps {
                sh '''
                   npm test
                   test -f ./build/index.html
                   npx serve -s build &
                   npx playwright test
                    '''
            }
        }
    }
    post {
        always {
            junit 'test-results/junit.xml'
        }
    }
}