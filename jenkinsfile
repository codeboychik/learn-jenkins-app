pipeline {
    agent {
        docker {
            image 'node:22-alpine'
            reuseNode true
        }
    }
    stages {
        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }
        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }
        stage('Test') {
            steps {
                sh '''
                   npm test
                   test -f ./build/index.html
                   npx serve -s build &
                   npx playwright test
                    '''
            }
        }
    }
    post {
        always {
            junit 'test-results/junit.xml'
        }
    }
}