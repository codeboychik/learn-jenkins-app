pipeline {
    agent {
        docker {
            image 'node:22-alpine'
            reuseNode true
        }
    }
    stages {
        stage('Install Dependencies') {
            steps {
                sh '''
                    npm -v
                    if [ -d node_modules ]; then
                        echo 'Using cached build'
                    else 
                        npm ci
                    fi                        
                   '''
            }
        }
        stage('Build and Test') {
            parallel {
                stage('Test') {
                    steps {
                        sh 'npm test'
                    }
                }
                stage('Build') {
                    steps {
                        sh 'npm run build'
                    }
                }
            }
        }
    }
}