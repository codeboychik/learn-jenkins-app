pipeline {
    agent {
        docker {
            image 'node:22-alpine'
            reuseNode true
        }
    }
    stages {
        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }
        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }
        stage('Test') {
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.50.0-noble'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    npm test
                    test -f ./build/index.html
                    npx serve -s build &
                    SERVER_PID=$!
                    npx playwright test
                    kill $SERVER_PID
                   '''
            }
        }
    }
    post {
        always {
            junit 'test-results/junit.xml'
        }
    }
}