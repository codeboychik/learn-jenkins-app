pipeline {
    agent {
        docker {
            image 'oven/bun:latest'
            reuseNode true
        }
    }
    stages {
        stage('Install Dependencies') {
            steps {
                sh '''
                    bun install  
                    bun -v
                    node -v               
                   '''
            }
        }
        stage('Build and Test') {
            steps {
                sh '''
                    bun run start 
                    bun run testp
                    bun run test
                    bun run build
                   '''
            }
        }
    }
}